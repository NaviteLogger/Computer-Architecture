   144 000000C3 CD21                        int 21h           ; Pobierz znak z klawiatury
   145 000000C5 3C0D                        cmp al, 13        ; Sprawdź, czy Enter
   146 000000C7 7414                        je done_input
   147                                  
   148 000000C9 2C30                        sub al, '0'       ; Konwertuj ASCII na cyfrę
   149 000000CB BA[BA00]                    mov dx, debug_digit
   150 000000CE E81B00                      call print_string
   151 000000D1 88C2                        mov dl, al
   152 000000D3 E81B00                      call print_char
   153                                  
   154 000000D6 6BDB0A                      imul bx, 10
   155 000000D9 01C3                        add bx, ax
   156 000000DB EBE4                        jmp read_digit
   157                                  
   158                                  done_input:
   159 000000DD 89D8                        mov ax, bx
   160                                  
   161                                      ; Debugowanie - wypisz wprowadzoną liczbę
   162 000000DF BA[B100]                    mov dx, debug_number_msg
   163 000000E2 E80700                      call print_string
   164 000000E5 E80E00                      call print_number
