    58                                  ; Procedura: find_primes
    59                                  ; Znajduje liczby pierwsze w zadanym przedziale
    60                                  ;----------------------------------------------
    61                                  find_primes:
    62 0000005B A1[0000]                    mov ax, [min]
    63 0000005E BA[4E00]                    mov dx, finding_primes
    64 00000061 E88800                      call print_string
    65                                      
    66                                  next_number:
    67 00000064 3B06[0200]                  cmp ax, [max]    ; Czy osiągnęliśmy max?
    68 00000068 7F2E                        jg done          ; Jeśli tak, zakończ
    69                                  
    70                                      ; Debugowanie to moja pasja
    71 0000006A BA[8800]                    mov dx, current_number_msg
    72 0000006D E87C00                      call print_string
    73 00000070 E88300                      call print_number
    74                                  
    75 00000073 BA[A500]                    mov dx, max_value_msg
