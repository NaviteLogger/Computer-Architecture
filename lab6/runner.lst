     1                                  section .text
     2                                      org 100h
     3                                  
     4                                  start:
     5 00000000 E80B00                      call get_input       ; Pobierz zakres od użytkownika
     6 00000003 BA[3F00]                    mov dx, after_input
     7 00000006 E80D01                      call print_string
     8 00000009 E85B00                      call find_primes     ; Znajdź liczby pierwsze
     9 0000000C EBF2                        jmp start            ; Powtarzaj operację dla nowych zakresów
    10                                  
    11                                  ;----------------------------------------------
    12                                  ; Procedura: get_input
    13                                  ; Pobiera zakres od użytkownika
    14                                  ;----------------------------------------------
    15                                  get_input:
    16                                      ; Pobierz minimalną wartość
    17 0000000E BA[0000]                    mov dx, prompt1        ; 1. Załaduj adres `prompt1` do rejestru DX
    18 00000011 E80201                      call print_string      ; 2. Wywołaj procedurę `print_string` (wypisuje "Enter min value:")
    19 00000014 E8AF00                      call get_number        ; 3. Wywołaj procedurę `get_number`, aby pobrać liczbę od użytkownika
    20                                  
    21                                      ; Debugowanie: Sprawdź, co jest w AX po odczytaniu liczby
    22 00000017 BA[5C00]                    mov dx, debug_ax_value
    23 0000001A E8F900                      call print_string
    24 0000001D E8FD00                      call print_number
    25 00000020 E81901                      call new_line
    26                                  
    27                                      ; Zapisz wartość w zmiennej `min`
    28 00000023 A3[0000]                    mov [min], ax          ; 4. Zapisz wartość z rejestru AX do zmiennej `min`
    29                                  
    30                                      ; Debug: Sprawdź, co zapisano w `min`
    31 00000026 A1[0000]                    mov ax, [min]          ; 5. Załaduj wartość `min` z pamięci do rejestru AX
    32 00000029 BA[9A00]                    mov dx, debug_min_set  ; 6. Załaduj adres komunikatu debugowego do rejestru DX
    33 0000002C E8E700                      call print_string      ; 7. Wypisz komunikat "Value set for min:"
    34 0000002F E8EB00                      call print_number      ; 8. Wypisz wartość z rejestru AX
    35 00000032 E80701                      call new_line          ; 9. Przejdź do nowej linii
    36                                  
    37                                      ; Pobierz maksymalną wartość
    38 00000035 BA[1200]                    mov dx, prompt2
    39 00000038 E8DB00                      call print_string
    40 0000003B E88800                      call get_number
    41 0000003E A3[0200]                    mov [max], ax    ; Zapisz wartość w `max`
    42                                  
    43                                      ; Debug: Sprawdź, co zapisano w `max`
    44 00000041 A1[0200]                    mov ax, [max]
    45 00000044 BA[AE00]                    mov dx, debug_max_set
    46 00000047 E8CC00                      call print_string
    47 0000004A E8D000                      call print_number
    48 0000004D E8EC00                      call new_line
    49                                  
    50                                      ; Sprawdź, czy min < max
    51 00000050 A1[0000]                    mov ax, [min]
    52 00000053 3B06[0200]                  cmp ax, [max]
    53 00000057 7D07                        jge invalid_range
    54                                  
    55                                      ; Debugowanie to moja pasja
    56 00000059 BA[3200]                    mov dx, valid_range
    57 0000005C E8B700                      call print_string
    58                                  
    59 0000005F C3                          ret
    60                                  
    61                                  invalid_range:
    62 00000060 BA[FF00]                    mov dx, invalid_input
    63 00000063 E8B000                      call print_string
    64 00000066 C3                          ret
    65                                  
    66                                  ;----------------------------------------------
    67                                  ; Procedura: find_primes
    68                                  ; Znajduje liczby pierwsze w zadanym przedziale
    69                                  ;----------------------------------------------
    70                                  find_primes:
    71 00000067 A1[0000]                    mov ax, [min]
    72 0000006A BA[8200]                    mov dx, debug_min
    73 0000006D E8A600                      call print_string
    74 00000070 E8AA00                      call print_number
    75 00000073 E8C600                      call new_line
    76                                  
    77 00000076 A1[0200]                    mov ax, [max]
    78 00000079 BA[8E00]                    mov dx, debug_max
    79 0000007C E89700                      call print_string
    80 0000007F E89B00                      call print_number
    81 00000082 E8B700                      call new_line
    82                                  
    83 00000085 A1[0000]                    mov ax, [min]
    84                                      
    85                                  next_number:
    86 00000088 3B06[0200]                  cmp ax, [max]    ; Czy osiągnęliśmy max?
    87 0000008C 7F19                        jg done          ; Jeśli tak, zakończ
    88                                      
    89 0000008E 50                          push ax          ; Zachowaj wartość na stosie
    90 0000008F E81600                      call is_prime    ; Sprawdź, czy liczba jest pierwsza
    91 00000092 58                          pop ax           ; Przywróć wartość ze stosu
    92                                      
    93 00000093 83FB01                      cmp bx, 1        ; Jeśli BX = 1, to liczba jest pierwsza
    94 00000096 750C                        jne skip_number
    95                                  
    96                                      ; Wyświetl liczbę pierwszą
    97 00000098 BA[A001]                    mov dx, prime_msg
    98 0000009B E87800                      call print_string
    99 0000009E E87C00                      call print_number
   100 000000A1 E89800                      call new_line
   101                                  
   102                                  skip_number:
   103 000000A4 40                          inc ax           ; Przejdź do następnej liczby
   104 000000A5 EBE1                        jmp next_number
   105                                  
   106                                  done:
   107 000000A7 C3                          ret
   108                                  
   109                                  ;----------------------------------------------
   110                                  ; Procedura: is_prime
   111                                  ; Sprawdza, czy liczba w AX jest pierwsza
   112                                  ; Zwraca wynik w BX (1 = pierwsza, 0 = niepierwsza)
   113                                  ;----------------------------------------------
   114                                  is_prime:
   115 000000A8 BB0200                      mov bx, 2
   116 000000AB 89C1                        mov cx, ax
   117                                      
   118                                  check_divisor:
   119 000000AD 39CB                        cmp bx, cx
   120 000000AF 7D0D                        jge prime_found   ; Jeśli bx >= cx, liczba jest pierwsza
   121                                  
   122                                      ; Sprawdź, czy ax jest podzielne przez bx
   123 000000B1 BA0000                      mov dx, 0
   124 000000B4 F7F3                        div bx
   125 000000B6 83FA00                      cmp dx, 0
   126 000000B9 7407                        je not_a_prime    ; Jeśli reszta = 0, to liczba nie jest pierwsza
   127                                  
   128 000000BB 43                          inc bx            ; Sprawdź kolejny dzielnik
   129 000000BC EBEF                        jmp check_divisor
   130                                  
   131                                  prime_found:
   132 000000BE BB0100                      mov bx, 1         ; Liczba jest pierwsza
   133 000000C1 C3                          ret
   134                                  
   135                                  not_a_prime:
   136 000000C2 BB0000                      mov bx, 0         ; Liczba nie jest pierwsza
   137 000000C5 C3                          ret
   138                                  
   139                                  ;----------------------------------------------
   140                                  ; Procedura: get_number
   141                                  ; Pobiera liczbę od użytkownika
   142                                  ; Zwraca wynik w AX
   143                                  ;----------------------------------------------
   144                                  get_number:
   145 000000C6 31C0                        xor ax, ax         ; Wyzeruj AX, aby nie było śmieci
   146 000000C8 31DB                        xor bx, bx         ; Wyzeruj BX (będzie używany do przechowywania liczby)
   147                                  
   148                                  read_digit:
   149 000000CA B401                        mov ah, 1          ; Funkcja DOS do odczytu znaku z klawiatury
   150 000000CC CD21                        int 21h            ; Pobierz znak od użytkownika
   151                                      
   152 000000CE 3C0D                        cmp al, 13         ; Sprawdź, czy Enter (kod ASCII 13)
   153 000000D0 7435                        je done_input      ; Jeśli Enter, zakończ wczytywanie
   154                                  
   155                                  
   156                                      ; Idiotoodporność
   157 000000D2 3C30                        cmp al, "0"        ; Sprawdź, czy znak jest cyfrą
   158 000000D4 7C29                        jl invalid_input    ; Jeśli nie, zignoruj
   159                                  
   160 000000D6 3C39                        cmp al, "9"        ; Sprawdź, czy znak jest cyfrą
   161 000000D8 7F25                        jg invalid_input    ; Jeśli nie, zignoruj
   162                                  
   163 000000DA 2C30                        sub al, "0"       ; Konwertuj znak ASCII na cyfrę
   164                                  
   165                                      ; Przesuń cyfry o jedno miejsce w lewo
   166 000000DC 6BDB0A                      imul bx, 10
   167                                      
   168                                      ; Debugowanie: Sprawdź `BX` po mnożeniu
   169 000000DF 89D8                        mov ax, bx
   170 000000E1 BA[F200]                    mov dx, debug_mult
   171 000000E4 E82F00                      call print_string
   172 000000E7 E83300                      call print_number
   173 000000EA E84F00                      call new_line
   174                                  
   175                                      ; Dodaj cyfrę do `BX`
   176 000000ED 01C3                        add bx, ax
   177                                      ; Debugowanie: Sprawdź `BX` po dodaniu cyfry
   178 000000EF 89D8                        mov ax, bx
   179 000000F1 BA[0901]                    mov dx, debug_add
   180 000000F4 E81F00                      call print_string
   181 000000F7 E82300                      call print_number
   182 000000FA E83F00                      call new_line
   183                                  
   184 000000FD EBCB                        jmp read_digit     ; Kontynuuj wczytywanie kolejnych cyfr
   185                                      
   186                                      
   187                                  invalid_input:
   188 000000FF BA[5101]                    mov dx, invalid_char_msg
   189 00000102 E81100                      call print_string
   190 00000105 EBC3                        jmp read_digit
   191                                  
   192                                  
   193                                  done_input:
   194 00000107 89D8                        mov ax, bx         ; Przenieś wynik do AX
   195                                  
   196                                      ; Debugowanie: Sprawdź wartość w AX przed powrotem
   197 00000109 BA[D700]                    mov dx, debug_number
   198 0000010C E80700                      call print_string
   199 0000010F E80B00                      call print_number
   200 00000112 E82700                      call new_line
   201 00000115 C3                          ret
   202                                  
   203                                  ;----------------------------------------------
   204                                  ; Procedura: print_string
   205                                  ; Wypisuje string zakończony znakiem $
   206                                  ;----------------------------------------------
   207                                  print_string:
   208 00000116 50                          push ax
   209 00000117 B409                        mov ah, 9
   210 00000119 CD21                        int 21h
   211 0000011B 58                          pop ax
   212 0000011C C3                          ret
   213                                  
   214                                  ;----------------------------------------------
   215                                  ; Procedura: print_number
   216                                  ; Wypisuje liczbę z AX
   217                                  ;----------------------------------------------
   218                                  print_number:
   219 0000011D 50                          push ax
   220 0000011E 31C9                        xor cx, cx
   221 00000120 BB0A00                      mov bx, 10
   222                                      
   223                                  print_digit:
   224 00000123 31D2                        xor dx, dx
   225 00000125 F7F3                        div bx
   226 00000127 80C230                      add dl, '0'
   227 0000012A 52                          push dx
   228 0000012B 41                          inc cx
   229 0000012C 83F800                      cmp ax, 0
   230 0000012F 75F2                        jne print_digit
   231                                  
   232                                  print_loop:
   233 00000131 5A                          pop dx
   234 00000132 B402                        mov ah, 2
   235 00000134 88C2                        mov dl, al
   236 00000136 CD21                        int 21h
   237 00000138 E2F7                        loop print_loop
   238 0000013A 58                          pop ax
   239 0000013B C3                          ret
   240                                  
   241                                  ;----------------------------------------------
   242                                  ; Procedura: new_line
   243                                  ; Wypisuje nową linię
   244                                  ;----------------------------------------------
   245                                  new_line:
   246 0000013C BA[A801]                    mov dx, newline
   247 0000013F E8D4FF                      call print_string
   248 00000142 C3                          ret
