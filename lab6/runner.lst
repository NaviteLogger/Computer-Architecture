   103                                  ;----------------------------------------------
   104                                  ; Procedura: is_prime
   105                                  ; Sprawdza, czy liczba w AX jest pierwsza
   106                                  ; Zwraca wynik w BX (1 = pierwsza, 0 = niepierwsza)
   107                                  ;----------------------------------------------
   108                                  is_prime:
   109 0000009F BB0200                      mov bx, 2
   110 000000A2 89C1                        mov cx, ax
   111                                      
   112                                  check_divisor:
   113 000000A4 39CB                        cmp bx, cx
   114 000000A6 7D0D                        jge prime_found   ; Jeśli bx >= cx, liczba jest pierwsza
   115                                  
   116                                      ; Sprawdź, czy ax jest podzielne przez bx
   117 000000A8 BA0000                      mov dx, 0
   118 000000AB F7F3                        div bx
   119 000000AD 83FA00                      cmp dx, 0
   120 000000B0 7407                        je not_a_prime    ; Jeśli reszta = 0, to liczba nie jest pierwsza
   121                                  
   122 000000B2 43                          inc bx            ; Sprawdź kolejny dzielnik
   123 000000B3 EBEF                        jmp check_divisor
   124                                  
   125                                  prime_found:
   126 000000B5 BB0100                      mov bx, 1         ; Liczba jest pierwsza
   127 000000B8 C3                          ret
   128                                  
   129                                  not_a_prime:
   130 000000B9 BB0000                      mov bx, 0         ; Liczba nie jest pierwsza
   131 000000BC C3                          ret
   132                                  
