     1                                  section .text
     2                                      org 100h
     3                                  
     4                                  start:
     5 00000000 31C0                        xor ax, ax
     6 00000002 31DB                        xor bx, bx
     7 00000004 31C9                        xor cx, cx
     8 00000006 31D2                        xor dx, dx
     9                                  
    10 00000008 E81200                      call get_input       ; Pobierz zakres od użytkownika
    11 0000000B BA[7700]                    mov dx, after_input
    12 0000000E E8DB00                      call print_string
    13 00000011 E80601                      call new_line
    14 00000014 E84100                      call find_primes     ; Znajdź liczby pierwsze
    15 00000017 EBE7                        jmp start            ; Powtarzaj operację dla nowych zakresów
    16                                  
    17 00000019 B44C                        mov ah, 0x4c 
    18 0000001B CD21                        int 21h
    19                                  
    20                                  ;----------------------------------------------
    21                                  ; Procedura: get_input
    22                                  ; Pobiera zakres od użytkownika
    23                                  ;----------------------------------------------
    24                                  get_input:
    25                                      ; Pobierz minimalną wartość
    26 0000001D BA[0000]                    mov dx, prompt1        ; 1. Załaduj adres `prompt1` do rejestru DX
    27 00000020 E8C900                      call print_string      ; 2. Wywołaj procedurę `print_string` (wypisuje "Enter min value:")
    28 00000023 E88200                      call get_number        ; 3. Wywołaj procedurę `get_number`, aby pobrać liczbę od użytkownika
    29                                  
    30                                      ; Zapisz wartość w zmiennej `min`
    31 00000026 891E[0000]                  mov [min], bx          ; 4. Zapisz wartość z rejestru AX do zmiennej `min`
    32 0000002A BB0000                      mov bx, 0              ; 5. Wyzeruj BX
    33                                  
    34                                      ; Pobierz maksymalną wartość
    35 0000002D BA[1200]                    mov dx, prompt2
    36 00000030 E8B900                      call print_string
    37 00000033 E87200                      call get_number
    38 00000036 891E[0200]                  mov [max], bx    ; Zapisz wartość w `max`
    39                                  
    40                                      ; Sprawdź, czy min < max
    41 0000003A A1[0000]                    mov ax, [min]
    42 0000003D 3B06[0200]                  cmp ax, [max]
    43 00000041 7D0A                        jge invalid_range
    44                                  
    45                                      ; Debugowanie to moja pasja
    46 00000043 BA[2400]                    mov dx, valid_range
    47 00000046 E8A300                      call print_string
    48 00000049 E8CE00                      call new_line
    49                                  
    50 0000004C C3                          ret
    51                                  
    52                                  invalid_range:
    53 0000004D BA[E300]                    mov dx, invalid_range_msg
    54 00000050 E89900                      call print_string
    55 00000053 E8C400                      call new_line
    56                                      
    57 00000056 EBC5                        jmp get_input
    58                                      
    59                                  
    60                                  ;----------------------------------------------
    61                                  ; Procedura: find_primes
    62                                  ; Znajduje liczby pierwsze w zadanym przedziale
    63                                  ;----------------------------------------------
    64                                  find_primes:
    65 00000058 A1[0000]                    mov ax, [min] ; Zaczynamy od dolnej granicy
    66 0000005B EB00                        jmp next_number
    67                                      
    68                                  next_number:
    69 0000005D 3B06[0200]                  cmp ax, [max]    ; Czy dojechaliśmy za górną granicę?
    70 00000061 7F1D                        jg done          ; Jeśli tak, zakończ
    71                                  
    72 00000063 50                          push ax          ; Zachowaj wartość na stosie
    73 00000064 E81A00                      call is_prime    ; Sprawdź, czy liczba jest pierwsza
    74 00000067 58                          pop ax           ; Przywróć wartość ze stosu
    75                                  
    76 00000068 83FB01                      cmp bx, 1        ; Jeśli BX = 1, to liczba jest pierwsza
    77 0000006B 7510                        jne skip_number
    78                                  
    79                                      ; Wyświetl liczbę pierwszą
    80 0000006D BA[0A01]                    mov dx, prime_msg
    81 00000070 E87900                      call print_string
    82                                      
    83 00000073 89C2                        mov dx, ax
    84 00000075 E87B00                      call print_number
    85 00000078 E89F00                      call new_line
    86 0000007B EB00                        jmp skip_number
    87                                  
    88                                  skip_number:
    89 0000007D 40                          inc ax           ; Przejdź do następnej liczby
    90 0000007E EBDD                        jmp next_number
    91                                  
    92                                  done:
    93 00000080 C3                          ret
    94                                  
    95                                  ;----------------------------------------------
    96                                  ; Procedura: is_prime
    97                                  ; Sprawdza, czy liczba w AX jest pierwsza
    98                                  ; Zwraca wynik w BX (1 = pierwsza, 0 = niepierwsza)
    99                                  ;----------------------------------------------
   100                                  is_prime:
   101 00000081 BB0200                      mov bx, 2  ; bx - pierwszy dzielnik
   102                                      
   103 00000084 83F801                      cmp ax, 1  ; 1 nie jest liczbą pierwszą
   104 00000087 7E1B                        jng not_a_prime
   105                                  
   106 00000089 89C1                        mov cx, ax ; cx - górna granica dzielników
   107 0000008B EB00                        jmp check_divisor
   108                                  
   109                                  check_divisor:
   110 0000008D 39CB                        cmp bx, cx
   111 0000008F 7D0F                        jge prime_found   ; Jeśli bx >= cx, liczba jest pierwsza
   112                                  
   113                                      ; Sprawdź, czy ax jest podzielne przez bx
   114 00000091 89C8                        mov ax, cx
   115 00000093 BA0000                      mov dx, 0
   116 00000096 F7F3                        div bx
   117                                      
   118 00000098 83FA00                      cmp dx, 0
   119 0000009B 7407                        je not_a_prime    ; Jeśli reszta = 0, to liczba nie jest pierwsza
   120                                  
   121 0000009D 43                          inc bx            ; Sprawdź kolejny dzielnik
   122 0000009E EBED                        jmp check_divisor
   123                                  
   124                                  prime_found:
   125 000000A0 BB0100                      mov bx, 1         ; Liczba jest pierwsza
   126 000000A3 C3                          ret
   127                                  
   128                                  not_a_prime:
   129 000000A4 BB0000                      mov bx, 0         ; Liczba nie jest pierwsza
   130 000000A7 C3                          ret
   131                                  
   132                                  ;----------------------------------------------
   133                                  ; Procedura: get_number
   134                                  ; Pobiera liczbę od użytkownika
   135                                  ; Zwraca wynik w AX
   136                                  ;----------------------------------------------
   137                                  get_number:
   138 000000A8 31C0                        xor ax, ax         ; Wyzeruj AX, aby nie było śmieci
   139 000000AA 31DB                        xor bx, bx         ; Wyzeruj BX (będzie używany do przechowywania liczby)
   140                                  
   141                                  read_digit:
   142 000000AC B401                        mov ah, 1          ; Funkcja DOS do odczytu znaku z klawiatury
   143 000000AE CD21                        int 21h            ; Pobierz znak od użytkownika
   144 000000B0 B400                        mov ah, 0          ; Wyzeruj rejestr AH
   145                                      
   146 000000B2 3C0D                        cmp al, 13         ; Sprawdź, czy Enter (kod ASCII 13)
   147 000000B4 7435                        je done_input      ; Jeśli Enter, zakończ wczytywanie
   148                                  
   149                                      ; Idiotoodporność
   150 000000B6 3C30                        cmp al, "0"        ; Sprawdź, czy znak jest cyfrą
   151 000000B8 7C22                        jl invalid_input   ; Jeśli nie, zignoruj
   152                                  
   153 000000BA 3C39                        cmp al, "9"        ; Sprawdź, czy znak jest cyfrą
   154 000000BC 7F1E                        jg invalid_input   ; Jeśli nie, zignoruj
   155                                  
   156 000000BE 2C30                        sub al, "0"        ; Konwertuj znak ASCII na cyfrę
   157 000000C0 53                          push bx            ; Zachowaj wartość na stosie
   158 000000C1 6BDB0A                      imul bx, 10        ; Przesuń w lewo bx o 1 miejsce   
   159                                      
   160                                      ; Dodanie dx do ax
   161 000000C4 01C3                        add bx, ax         ; Dodaj wartość do BX
   162 000000C6 59                          pop cx             ; Odczytaj wartość ze stosu
   163                                  
   164 000000C7 39CB                        cmp bx, cx         ; Sprawdź, czy nowa wartość mieści się w 16 bitach
   165 000000C9 7C02                        jl overflow  ; Jeśli nie, zignoruj
   166                                  
   167 000000CB EBDF                        jmp read_digit     ; Kontynuuj wczytywanie kolejnych cyfr
   168                                      
   169                                  overflow:
   170 000000CD E84A00                      call new_line
   171 000000D0 BA[3100]                    mov dx, overflow_msg
   172 000000D3 E81600                      call print_string
   173 000000D6 E84100                      call new_line
   174 000000D9 E924FF                      jmp start
   175                                      
   176                                  invalid_input:
   177 000000DC E83B00                      call new_line
   178 000000DF BA[AE00]                    mov dx, invalid_char_msg
   179 000000E2 E80700                      call print_string
   180 000000E5 E83200                      call new_line
   181 000000E8 E915FF                      jmp start
   182                                  
   183                                  
   184                                  done_input:
   185 000000EB C3                          ret
   186                                  
   187                                  ;----------------------------------------------
   188                                  ; Procedura: print_string
   189                                  ; Wypisuje string zakończony znakiem $
   190                                  ;----------------------------------------------
   191                                  print_string:
   192 000000EC 50                          push ax
   193 000000ED B409                        mov ah, 9
   194 000000EF CD21                        int 21h
   195 000000F1 58                          pop ax
   196 000000F2 C3                          ret
   197                                  
   198                                  ;----------------------------------------------
   199                                  ; Procedura: print_number
   200                                  ; Wypisuje liczbę z AX
   201                                  ;----------------------------------------------
   202                                  print_number:
   203 000000F3 50                          push ax
   204 000000F4 BB0A00                      mov bx, 10
   205 000000F7 EB00                        jmp print_digit
   206                                      
   207                                  print_digit:
   208 000000F9 89D0                        mov ax, dx
   209 000000FB 31D2                        xor dx, dx
   210 000000FD F7F3                        div bx ; Ax - to co wypisujemy, dx - reszta, którą wypiszemy później
   211                                  
   212 000000FF 83F800                      cmp ax, 0
   213 00000102 740D                        je end_print_digit
   214                                  
   215 00000104 52                          push dx ; Zachowanie reszty na stosie
   216                                      
   217 00000105 89C2                        mov dx, ax
   218 00000107 83C230                      add dx, "0"    ; Konwersja cyfry na znak
   219                                      ; mov dx, test_msg
   220 0000010A B402                        mov ah, 2
   221 0000010C CD21                        int 21h
   222                                  
   223 0000010E 5A                          pop dx ; Odczytanie reszty ze stosu
   224                                  
   225                                      
   226 0000010F EBE8                        jmp print_digit
   227                                  
   228                                  end_print_digit:
   229 00000111 83C230                      add dx, "0"
   230 00000114 B402                        mov ah, 2
   231 00000116 CD21                        int 21h
   232                                  
   233 00000118 58                          pop ax
   234 00000119 C3                          ret
   235                                  
   236                                  ;----------------------------------------------
   237                                  ; Procedura: new_line
   238                                  ; Wypisuje nową linię
   239                                  ;----------------------------------------------
   240                                  new_line:
   241 0000011A BA[1201]                    mov dx, newline
   242 0000011D E8CCFF                      call print_string
   243 00000120 C3                          ret
