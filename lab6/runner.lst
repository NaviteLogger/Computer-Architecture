     1                                  section .text
     2                                      org 100h
     3                                  
     4                                  start:
     5 00000000 E80B00                      call get_input       ; Pobierz zakres od użytkownika
     6 00000003 BA[3F00]                    mov dx, after_input
     7 00000006 E8C000                      call print_string
     8 00000009 E83600                      call find_primes     ; Znajdź liczby pierwsze
     9 0000000C EBF2                        jmp start            ; Powtarzaj operację dla nowych zakresów
    10                                  
    11                                  ;----------------------------------------------
    12                                  ; Procedura: get_input
    13                                  ; Pobiera zakres od użytkownika
    14                                  ;----------------------------------------------
    15                                  get_input:
    16                                      ; Pobierz minimalną wartość
    17 0000000E BA[0000]                    mov dx, prompt1        ; 1. Załaduj adres `prompt1` do rejestru DX
    18 00000011 E8B500                      call print_string      ; 2. Wywołaj procedurę `print_string` (wypisuje "Enter min value:")
    19 00000014 E88A00                      call get_number        ; 3. Wywołaj procedurę `get_number`, aby pobrać liczbę od użytkownika
    20                                  
    21                                      ; Zapisz wartość w zmiennej `min`
    22 00000017 891E[0000]                  mov [min], bx          ; 4. Zapisz wartość z rejestru AX do zmiennej `min`
    23 0000001B BB0000                      mov bx, 0              ; 5. Wyzeruj BX
    24                                  
    25                                      ; Pobierz maksymalną wartość
    26 0000001E BA[1200]                    mov dx, prompt2
    27 00000021 E8A500                      call print_string
    28 00000024 E87A00                      call get_number
    29 00000027 891E[0200]                  mov [max], bx    ; Zapisz wartość w `max`
    30                                  
    31                                      ; Sprawdź, czy min < max
    32 0000002B A1[0000]                    mov ax, [min]
    33 0000002E 3B06[0200]                  cmp ax, [max]
    34 00000032 7D07                        jge invalid_range
    35                                  
    36                                      ; Debugowanie to moja pasja
    37 00000034 BA[3200]                    mov dx, valid_range
    38 00000037 E88F00                      call print_string
    39                                  
    40 0000003A C3                          ret
    41                                  
    42                                  invalid_range:
    43 0000003B BA[8601]                    mov dx, invalid_range_msg
    44 0000003E E88800                      call print_string
    45 00000041 C3                          ret
    46                                  
    47                                  ;----------------------------------------------
    48                                  ; Procedura: find_primes
    49                                  ; Znajduje liczby pierwsze w zadanym przedziale
    50                                  ;----------------------------------------------
    51                                  find_primes:
    52 00000042 A1[0000]                    mov ax, [min]
    53 00000045 BA[8200]                    mov dx, debug_min
    54 00000048 E87E00                      call print_string
    55 0000004B E88200                      call print_number
    56 0000004E E89E00                      call new_line
    57                                  
    58 00000051 A1[0200]                    mov ax, [max]
    59 00000054 BA[8E00]                    mov dx, debug_max
    60 00000057 E86F00                      call print_string
    61 0000005A E87300                      call print_number
    62 0000005D E88F00                      call new_line
    63                                  
    64 00000060 A1[0000]                    mov ax, [min]
    65                                      
    66                                  next_number:
    67 00000063 3B06[0200]                  cmp ax, [max]    ; Czy osiągnęliśmy max?
    68 00000067 7F19                        jg done          ; Jeśli tak, zakończ
    69                                      
    70 00000069 50                          push ax          ; Zachowaj wartość na stosie
    71 0000006A E81600                      call is_prime    ; Sprawdź, czy liczba jest pierwsza
    72 0000006D 58                          pop ax           ; Przywróć wartość ze stosu
    73                                      
    74 0000006E 83FB01                      cmp bx, 1        ; Jeśli BX = 1, to liczba jest pierwsza
    75 00000071 750C                        jne skip_number
    76                                  
    77                                      ; Wyświetl liczbę pierwszą
    78 00000073 BA[C701]                    mov dx, prime_msg
    79 00000076 E85000                      call print_string
    80 00000079 E85400                      call print_number
    81 0000007C E87000                      call new_line
    82                                  
    83                                  skip_number:
    84 0000007F 40                          inc ax           ; Przejdź do następnej liczby
    85 00000080 EBE1                        jmp next_number
    86                                  
    87                                  done:
    88 00000082 C3                          ret
    89                                  
    90                                  ;----------------------------------------------
    91                                  ; Procedura: is_prime
    92                                  ; Sprawdza, czy liczba w AX jest pierwsza
    93                                  ; Zwraca wynik w BX (1 = pierwsza, 0 = niepierwsza)
    94                                  ;----------------------------------------------
    95                                  is_prime:
    96 00000083 BB0200                      mov bx, 2
    97 00000086 89C1                        mov cx, ax
    98                                      
    99                                  check_divisor:
   100 00000088 39CB                        cmp bx, cx
   101 0000008A 7D0D                        jge prime_found   ; Jeśli bx >= cx, liczba jest pierwsza
   102                                  
   103                                      ; Sprawdź, czy ax jest podzielne przez bx
   104 0000008C BA0000                      mov dx, 0
   105 0000008F F7F3                        div bx
   106 00000091 83FA00                      cmp dx, 0
   107 00000094 7407                        je not_a_prime    ; Jeśli reszta = 0, to liczba nie jest pierwsza
   108                                  
   109 00000096 43                          inc bx            ; Sprawdź kolejny dzielnik
   110 00000097 EBEF                        jmp check_divisor
   111                                  
   112                                  prime_found:
   113 00000099 BB0100                      mov bx, 1         ; Liczba jest pierwsza
   114 0000009C C3                          ret
   115                                  
   116                                  not_a_prime:
   117 0000009D BB0000                      mov bx, 0         ; Liczba nie jest pierwsza
   118 000000A0 C3                          ret
   119                                  
   120                                  ;----------------------------------------------
   121                                  ; Procedura: get_number
   122                                  ; Pobiera liczbę od użytkownika
   123                                  ; Zwraca wynik w AX
   124                                  ;----------------------------------------------
   125                                  get_number:
   126 000000A1 31C0                        xor ax, ax         ; Wyzeruj AX, aby nie było śmieci
   127 000000A3 31DB                        xor bx, bx         ; Wyzeruj BX (będzie używany do przechowywania liczby)
   128                                  
   129                                  read_digit:
   130 000000A5 B401                        mov ah, 1          ; Funkcja DOS do odczytu znaku z klawiatury
   131 000000A7 CD21                        int 21h            ; Pobierz znak od użytkownika
   132 000000A9 B400                        mov ah, 0          ; Wyzeruj rejestr AH
   133                                      
   134 000000AB 3C0D                        cmp al, 13         ; Sprawdź, czy Enter (kod ASCII 13)
   135 000000AD 7419                        je done_input      ; Jeśli Enter, zakończ wczytywanie
   136                                  
   137                                      ; Idiotoodporność
   138 000000AF 3C30                        cmp al, "0"        ; Sprawdź, czy znak jest cyfrą
   139 000000B1 7C0D                        jl invalid_input   ; Jeśli nie, zignoruj
   140                                  
   141 000000B3 3C39                        cmp al, "9"        ; Sprawdź, czy znak jest cyfrą
   142 000000B5 7F09                        jg invalid_input   ; Jeśli nie, zignoruj
   143                                  
   144 000000B7 2C30                        sub al, "0"        ; Konwertuj znak ASCII na cyfrę
   145 000000B9 6BDB0A                      imul bx, 10        ; Przesuń w lewo bx o 1 miejsce   
   146                                      
   147                                      ; Dodanie dx do ax
   148 000000BC 01C3                        add bx, ax         ; Dodaj wartość do BX
   149                                  
   150 000000BE EBE5                        jmp read_digit     ; Kontynuuj wczytywanie kolejnych cyfr
   151                                      
   152                                      
   153                                  invalid_input:
   154 000000C0 BA[5101]                    mov dx, invalid_char_msg
   155 000000C3 E80300                      call print_string
   156 000000C6 EBDD                        jmp read_digit
   157                                  
   158                                  
   159                                  done_input:
   160 000000C8 C3                          ret
   161                                  
   162                                  ;----------------------------------------------
   163                                  ; Procedura: print_string
   164                                  ; Wypisuje string zakończony znakiem $
   165                                  ;----------------------------------------------
   166                                  print_string:
   167 000000C9 50                          push ax
   168 000000CA B409                        mov ah, 9
   169 000000CC CD21                        int 21h
   170 000000CE 58                          pop ax
   171 000000CF C3                          ret
   172                                  
   173                                  ;----------------------------------------------
   174                                  ; Procedura: print_number
   175                                  ; Wypisuje liczbę z AX
   176                                  ;----------------------------------------------
   177                                  print_number:
   178 000000D0 50                          push ax
   179 000000D1 31C9                        xor cx, cx
   180 000000D3 BB0A00                      mov bx, 10
   181                                      
   182                                  print_digit:
   183 000000D6 31D2                        xor dx, dx
   184 000000D8 F7F3                        div bx
   185 000000DA 80C230                      add dl, '0'
   186 000000DD 52                          push dx
   187 000000DE 41                          inc cx
   188 000000DF 83F800                      cmp ax, 0
   189 000000E2 75F2                        jne print_digit
   190                                  
   191                                  print_loop:
   192 000000E4 5A                          pop dx
   193 000000E5 B402                        mov ah, 2
   194 000000E7 88C2                        mov dl, al
   195 000000E9 CD21                        int 21h
   196 000000EB E2F7                        loop print_loop
   197 000000ED 58                          pop ax
   198 000000EE C3                          ret
   199                                  
   200                                  ;----------------------------------------------
   201                                  ; Procedura: new_line
   202                                  ; Wypisuje nową linię
   203                                  ;----------------------------------------------
   204                                  new_line:
   205 000000EF BA[CF01]                    mov dx, newline
   206 000000F2 E8D4FF                      call print_string
   207 000000F5 C3                          ret
   208                                  
