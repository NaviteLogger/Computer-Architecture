    11                                  ;----------------------------------------------
    12                                  ; Procedura: get_input
    13                                  ; Pobiera zakres od użytkownika
    14                                  ;----------------------------------------------
    15                                  get_input:
    16                                      ; Pobierz minimalną wartość
    17 0000000E BA[0000]                    mov dx, prompt1
    18 00000011 E8D800                      call print_string
