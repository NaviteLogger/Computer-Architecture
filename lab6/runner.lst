     1                                  section .text
     2                                      org 100h
     3                                  
     4                                  start:
     5 00000000 E80B00                      call get_input       ; Pobierz zakres od użytkownika
     6 00000003 BA[3F00]                    mov dx, after_input
     7 00000006 E82401                      call print_string
     8 00000009 E85B00                      call find_primes     ; Znajdź liczby pierwsze
     9 0000000C EBF2                        jmp start            ; Powtarzaj operację dla nowych zakresów
    10                                  
    11                                  ;----------------------------------------------
    12                                  ; Procedura: get_input
    13                                  ; Pobiera zakres od użytkownika
    14                                  ;----------------------------------------------
    15                                  get_input:
    16                                      ; Pobierz minimalną wartość
    17 0000000E BA[0000]                    mov dx, prompt1        ; 1. Załaduj adres `prompt1` do rejestru DX
    18 00000011 E81901                      call print_string      ; 2. Wywołaj procedurę `print_string` (wypisuje "Enter min value:")
    19 00000014 E8AF00                      call get_number        ; 3. Wywołaj procedurę `get_number`, aby pobrać liczbę od użytkownika
    20                                  
    21                                      ; Debugowanie: Sprawdź, co jest w AX po odczytaniu liczby
    22 00000017 BA[8600]                    mov dx, debug_ax_value
    23 0000001A E81001                      call print_string
    24 0000001D E81601                      call print_number
    25 00000020 E83201                      call new_line
    26                                  
    27                                      ; Zapisz wartość w zmiennej `min`
    28 00000023 A3[0000]                    mov [min], ax          ; 4. Zapisz wartość z rejestru AX do zmiennej `min`
    29                                  
    30                                      ; Debug: Sprawdź, co zapisano w `min`
    31 00000026 A1[0000]                    mov ax, [min]          ; 5. Załaduj wartość `min` z pamięci do rejestru AX
    32 00000029 BA[C400]                    mov dx, debug_min_set  ; 6. Załaduj adres komunikatu debugowego do rejestru DX
    33 0000002C E8FE00                      call print_string      ; 7. Wypisz komunikat "Value set for min:"
    34 0000002F E80401                      call print_number      ; 8. Wypisz wartość z rejestru AX
    35 00000032 E82001                      call new_line          ; 9. Przejdź do nowej linii
    36                                  
    37                                      ; Pobierz maksymalną wartość
    38 00000035 BA[1200]                    mov dx, prompt2
    39 00000038 E8F200                      call print_string
    40 0000003B E88800                      call get_number
    41 0000003E A3[0200]                    mov [max], ax    ; Zapisz wartość w `max`
    42                                  
    43                                      ; Debug: Sprawdź, co zapisano w `max`
    44 00000041 A1[0200]                    mov ax, [max]
    45 00000044 BA[D800]                    mov dx, debug_max_set
    46 00000047 E8E300                      call print_string
    47 0000004A E8E900                      call print_number
    48 0000004D E80501                      call new_line
    49                                  
    50                                      ; Sprawdź, czy min < max
    51 00000050 A1[0000]                    mov ax, [min]
    52 00000053 3B06[0200]                  cmp ax, [max]
    53 00000057 7D07                        jge invalid_range
    54                                  
    55                                      ; Debugowanie to moja pasja
    56 00000059 BA[3200]                    mov dx, valid_range
    57 0000005C E8CE00                      call print_string
    58                                  
    59 0000005F C3                          ret
    60                                  
    61                                  invalid_range:
    62 00000060 BA[5C00]                    mov dx, invalid_input
    63 00000063 E8C700                      call print_string
    64 00000066 C3                          ret
