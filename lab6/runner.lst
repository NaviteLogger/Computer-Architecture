   194 000000FE F7F3                        div bx
   195 00000100 80C230                      add dl, '0'
   196 00000103 52                          push dx
   197 00000104 41                          inc cx
   198 00000105 83F800                      cmp ax, 0
   199 00000108 75F2                        jne print_digit
   200                                  
   201                                  print_loop:
   202 0000010A 5A                          pop dx
   203 0000010B B402                        mov ah, 2
   204 0000010D 88C2                        mov dl, al
   205 0000010F CD21                        int 21h
   206 00000111 E2F7                        loop print_loop
   207 00000113 58                          pop ax
   208 00000114 C3                          ret
