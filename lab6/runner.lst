    66                                  ;----------------------------------------------
    67                                  ; Procedura: find_primes
    68                                  ; Znajduje liczby pierwsze w zadanym przedziale
    69                                  ;----------------------------------------------
    70                                  find_primes:
    71 00000067 A1[0000]                    mov ax, [min]
    72 0000006A BA[AC00]                    mov dx, debug_min
    73 0000006D E8BD00                      call print_string
    74 00000070 E8C300                      call print_number
    75 00000073 E8DF00                      call new_line
    76                                  
    77 00000076 A1[0200]                    mov ax, [max]
    78 00000079 BA[B800]                    mov dx, debug_max
    79 0000007C E8AE00                      call print_string
    80 0000007F E8B400                      call print_number
    81 00000082 E8D000                      call new_line
    82                                  
    83 00000085 A1[0000]                    mov ax, [min]
    84                                      
    85                                  next_number:
    86 00000088 3B06[0200]                  cmp ax, [max]    ; Czy osiągnęliśmy max?
    87 0000008C 7F19                        jg done          ; Jeśli tak, zakończ
    88                                      
    89 0000008E 50                          push ax          ; Zachowaj wartość na stosie
    90 0000008F E81600                      call is_prime    ; Sprawdź, czy liczba jest pierwsza
    91 00000092 58                          pop ax           ; Przywróć wartość ze stosu
    92                                      
    93 00000093 83FB01                      cmp bx, 1        ; Jeśli BX = 1, to liczba jest pierwsza
    94 00000096 750C                        jne skip_number
    95                                  
    96                                      ; Wyświetl liczbę pierwszą
    97 00000098 BA[CA01]                    mov dx, prime_msg
    98 0000009B E88F00                      call print_string
    99 0000009E E89500                      call print_number
   100 000000A1 E8B100                      call new_line
   101                                  
   102                                  skip_number:
   103 000000A4 40                          inc ax           ; Przejdź do następnej liczby
   104 000000A5 EBE1                        jmp next_number
   105                                  
   106                                  done:
   107 000000A7 C3                          ret
   108                                  
   109                                  ;----------------------------------------------
   110                                  ; Procedura: is_prime
   111                                  ; Sprawdza, czy liczba w AX jest pierwsza
   112                                  ; Zwraca wynik w BX (1 = pierwsza, 0 = niepierwsza)
   113                                  ;----------------------------------------------
   114                                  is_prime:
   115 000000A8 BB0200                      mov bx, 2
   116 000000AB 89C1                        mov cx, ax
   117                                      
   118                                  check_divisor:
   119 000000AD 39CB                        cmp bx, cx
   120 000000AF 7D0D                        jge prime_found   ; Jeśli bx >= cx, liczba jest pierwsza
   121                                  
   122                                      ; Sprawdź, czy ax jest podzielne przez bx
   123 000000B1 BA0000                      mov dx, 0
   124 000000B4 F7F3                        div bx
   125 000000B6 83FA00                      cmp dx, 0
   126 000000B9 7407                        je not_a_prime    ; Jeśli reszta = 0, to liczba nie jest pierwsza
   127                                  
   128 000000BB 43                          inc bx            ; Sprawdź kolejny dzielnik
   129 000000BC EBEF                        jmp check_divisor
   130                                  
   131                                  prime_found:
   132 000000BE BB0100                      mov bx, 1         ; Liczba jest pierwsza
   133 000000C1 C3                          ret
   134                                  
   135                                  not_a_prime:
   136 000000C2 BB0000                      mov bx, 0         ; Liczba nie jest pierwsza
   137 000000C5 C3                          ret
   138                                  
   139                                  ;----------------------------------------------
   140                                  ; Procedura: get_number
   141                                  ; Pobiera liczbę od użytkownika
   142                                  ; Zwraca wynik w AX
   143                                  ;----------------------------------------------
   144                                  get_number:
   145 000000C6 31C0                        xor ax, ax         ; Wyzeruj AX, aby nie było śmieci
   146 000000C8 31DB                        xor bx, bx         ; Wyzeruj BX (będzie używany do przechowywania liczby)
   147                                  
   148                                  read_digit:
   149 000000CA B401                        mov ah, 1          ; Funkcja DOS do odczytu znaku z klawiatury
   150 000000CC CD21                        int 21h            ; Pobierz znak od użytkownika
   151                                  
   152                                      ; Debugowanie: Wyświetl odczytany znak
   153 000000CE 88C2                        mov dl, al
   154 000000D0 B402                        mov ah, 2
   155 000000D2 CD21                        int 21h
   156 000000D4 E87E00                      call new_line
   157                                  
   158 000000D7 3C0D                        cmp al, 13         ; Sprawdź, czy Enter (kod ASCII 13)
   159 000000D9 7443                        je done_input      ; Jeśli Enter, zakończ wczytywanie
   160                                  
   161                                      ; Debugowanie przed konwersją
   162 000000DB BA[5A01]                    mov dx, debug_before_sub
   163 000000DE E84C00                      call print_string
   164 000000E1 88C2                        mov dl, al
   165 000000E3 B402                        mov ah, 2
   166 000000E5 CD21                        int 21h
   167 000000E7 E86B00                      call new_line
   168                                  
   169 000000EA 2C30                        sub al, "0"       ; Konwertuj znak ASCII na cyfrę
   170                                  
   171                                      ; Debugowanie: Sprawdź wartość `AL` po konwersji na cyfrę
   172 000000EC BA[0F01]                    mov dx, debug_digit
   173 000000EF E83B00                      call print_string
   174 000000F2 88C2                        mov dl, al
   175 000000F4 B402                        mov ah, 2
   176 000000F6 CD21                        int 21h
   177 000000F8 E85A00                      call new_line
   178                                  
   179                                      ; Przesuń cyfry o jedno miejsce w lewo
   180 000000FB 6BDB0A                      imul bx, 10
   181                                      ; Debugowanie: Sprawdź `BX` po mnożeniu
   182 000000FE 89D8                        mov ax, bx
   183 00000100 BA[1C01]                    mov dx, debug_mult
   184 00000103 E82700                      call print_string
   185 00000106 E82D00                      call print_number
   186 00000109 E84900                      call new_line
   187                                  
   188                                      ; Dodaj cyfrę do `BX`
   189 0000010C 01C3                        add bx, ax
   190                                      ; Debugowanie: Sprawdź `BX` po dodaniu cyfry
   191 0000010E 89D8                        mov ax, bx
   192 00000110 BA[3301]                    mov dx, debug_add
   193 00000113 E81700                      call print_string
   194 00000116 E81D00                      call print_number
   195 00000119 E83900                      call new_line
   196                                  
   197 0000011C EBAC                        jmp read_digit     ; Kontynuuj wczytywanie kolejnych cyfr
   198                                  
   199                                  done_input:
   200 0000011E 89D8                        mov ax, bx         ; Przenieś wynik do AX
   201                                  
   202                                      ; Debugowanie: Sprawdź wartość w AX przed powrotem
   203 00000120 BA[0101]                    mov dx, debug_number
   204 00000123 E80700                      call print_string
   205 00000126 E80D00                      call print_number
   206 00000129 E82900                      call new_line
   207 0000012C C3                          ret
   208                                  
   209                                  ;----------------------------------------------
   210                                  ; Procedura: print_string
   211                                  ; Wypisuje string zakończony znakiem $
   212                                  ;----------------------------------------------
   213                                  print_string:
   214 0000012D 50                          push ax
   215 0000012E 52                          push dx
   216 0000012F B409                        mov ah, 9
   217 00000131 CD21                        int 21h
   218 00000133 5A                          pop dx
   219 00000134 58                          pop ax
   220 00000135 C3                          ret
   221                                  
   222                                  ;----------------------------------------------
   223                                  ; Procedura: print_number
   224                                  ; Wypisuje liczbę z AX
   225                                  ;----------------------------------------------
   226                                  print_number:
   227 00000136 50                          push ax
   228 00000137 31C9                        xor cx, cx
   229 00000139 BB0A00                      mov bx, 10
   230                                      
   231                                  print_digit:
   232 0000013C 31D2                        xor dx, dx
   233 0000013E F7F3                        div bx
   234 00000140 80C230                      add dl, '0'
   235 00000143 52                          push dx
   236 00000144 41                          inc cx
   237 00000145 83F800                      cmp ax, 0
   238 00000148 75F2                        jne print_digit
   239                                  
   240                                  print_loop:
   241 0000014A 5A                          pop dx
   242 0000014B B402                        mov ah, 2
   243 0000014D 88C2                        mov dl, al
   244 0000014F CD21                        int 21h
   245 00000151 E2F7                        loop print_loop
   246 00000153 58                          pop ax
   247 00000154 C3                          ret
   248                                  
   249                                  ;----------------------------------------------
   250                                  ; Procedura: new_line
   251                                  ; Wypisuje nową linię
   252                                  ;----------------------------------------------
   253                                  new_line:
   254 00000155 BA[D201]                    mov dx, newline
   255 00000158 E8D2FF                      call print_string
   256 0000015B C3                          ret
