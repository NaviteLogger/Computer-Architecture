     1                                  section .text
     2                                      org 100h
     3                                  
     4                                  start:
     5 00000000 BA[2400]                    mov dx, test_message
     6 00000003 E8E300                      call print_string   ; Test wypisywania
     7 00000006 CD20                        int 20h             ; Zakończ program
     8                                      
     9 00000008 E80B00                      call get_input       ; Pobierz zakres od użytkownika
    10 0000000B BA[3F00]                    mov dx, after_input
    11 0000000E E8D800                      call print_string
    12 00000011 E84F00                      call find_primes     ; Znajdź liczby pierwsze
    13 00000014 EBEA                        jmp start            ; Powtarzaj operację dla nowych zakresów
    14                                  
    15                                  ;----------------------------------------------
    16                                  ; Procedura: get_input
    17                                  ; Pobiera zakres od użytkownika
    18                                  ;----------------------------------------------
    19                                  get_input:
    20                                      ; Pobierz minimalną wartość
    21 00000016 BA[0000]                    mov dx, prompt1        ; 1. Załaduj adres `prompt1` do rejestru DX
    22 00000019 E8CD00                      call print_string      ; 2. Wywołaj procedurę `print_string` (wypisuje "Enter min value:")
    23 0000001C E8A300                      call get_number        ; 3. Wywołaj procedurę `get_number`, aby pobrać liczbę od użytkownika
    24 0000001F A3[0000]                    mov [min], ax          ; 4. Zapisz wartość z rejestru AX do zmiennej `min`
    25                                  
    26                                      ; Debug: Sprawdź, co zapisano w `min`
    27 00000022 A1[0000]                    mov ax, [min]          ; 5. Załaduj wartość `min` z pamięci do rejestru AX
    28 00000025 BA[AA00]                    mov dx, debug_min_set  ; 6. Załaduj adres komunikatu debugowego do rejestru DX
    29 00000028 E8BE00                      call print_string      ; 7. Wypisz komunikat "Value set for min:"
    30 0000002B E8C400                      call print_number      ; 8. Wypisz wartość z rejestru AX
    31 0000002E E8E000                      call new_line          ; 9. Przejdź do nowej linii
    32                                  
    33                                      
    34                                      ; Pobierz maksymalną wartość
    35 00000031 BA[1200]                    mov dx, prompt2
    36 00000034 E8B200                      call print_string
    37 00000037 E88800                      call get_number
    38 0000003A A3[0200]                    mov [max], ax    ; Zapisz wartość w `max`
    39                                  
    40                                      ; Debug: Sprawdź, co zapisano w `max`
    41 0000003D A1[0200]                    mov ax, [max]
    42 00000040 BA[BE00]                    mov dx, debug_max_set
    43 00000043 E8A300                      call print_string
    44 00000046 E8A900                      call print_number
    45 00000049 E8C500                      call new_line
    46                                  
    47                                      ; Sprawdź, czy min < max
    48 0000004C A1[0000]                    mov ax, [min]
    49 0000004F 3B06[0200]                  cmp ax, [max]
    50 00000053 7D07                        jge invalid_range
    51                                  
    52                                      ; Debugowanie to moja pasja
    53 00000055 BA[3200]                    mov dx, valid_range
    54 00000058 E88E00                      call print_string
    55                                  
    56 0000005B C3                          ret
    57                                  
    58                                  invalid_range:
    59 0000005C BA[5C00]                    mov dx, invalid_input
    60 0000005F E88700                      call print_string
    61 00000062 C3                          ret
    62                                  
    63                                  ;----------------------------------------------
    64                                  ; Procedura: find_primes
    65                                  ; Znajduje liczby pierwsze w zadanym przedziale
    66                                  ;----------------------------------------------
    67                                  find_primes:
    68 00000063 A1[0000]                    mov ax, [min]
    69 00000066 BA[9200]                    mov dx, debug_min
    70 00000069 E87D00                      call print_string
    71 0000006C E88300                      call print_number
    72 0000006F E89F00                      call new_line
    73                                  
    74 00000072 A1[0200]                    mov ax, [max]
    75 00000075 BA[9E00]                    mov dx, debug_max
    76 00000078 E86E00                      call print_string
    77 0000007B E87400                      call print_number
    78 0000007E E89000                      call new_line
    79                                  
    80 00000081 A1[0000]                    mov ax, [min]
    81                                      
    82                                  next_number:
    83 00000084 3B06[0200]                  cmp ax, [max]    ; Czy osiągnęliśmy max?
    84 00000088 7F19                        jg done          ; Jeśli tak, zakończ
    85                                      
    86 0000008A 50                          push ax          ; Zachowaj wartość na stosie
    87 0000008B E81600                      call is_prime    ; Sprawdź, czy liczba jest pierwsza
    88 0000008E 58                          pop ax           ; Przywróć wartość ze stosu
    89                                      
    90 0000008F 83FB01                      cmp bx, 1        ; Jeśli BX = 1, to liczba jest pierwsza
    91 00000092 750C                        jne skip_number
    92                                  
    93                                      ; Wyświetl liczbę pierwszą
    94 00000094 BA[0101]                    mov dx, prime_msg
    95 00000097 E84F00                      call print_string
    96 0000009A E85500                      call print_number
    97 0000009D E87100                      call new_line
    98                                  
    99                                  skip_number:
   100 000000A0 40                          inc ax           ; Przejdź do następnej liczby
   101 000000A1 EBE1                        jmp next_number
   102                                  
   103                                  done:
   104 000000A3 C3                          ret
   105                                  
   106                                  ;----------------------------------------------
   107                                  ; Procedura: is_prime
   108                                  ; Sprawdza, czy liczba w AX jest pierwsza
   109                                  ; Zwraca wynik w BX (1 = pierwsza, 0 = niepierwsza)
   110                                  ;----------------------------------------------
   111                                  is_prime:
   112 000000A4 BB0200                      mov bx, 2
   113 000000A7 89C1                        mov cx, ax
   114                                      
   115                                  check_divisor:
   116 000000A9 39CB                        cmp bx, cx
   117 000000AB 7D0D                        jge prime_found   ; Jeśli bx >= cx, liczba jest pierwsza
   118                                  
   119                                      ; Sprawdź, czy ax jest podzielne przez bx
   120 000000AD BA0000                      mov dx, 0
   121 000000B0 F7F3                        div bx
   122 000000B2 83FA00                      cmp dx, 0
   123 000000B5 7407                        je not_a_prime    ; Jeśli reszta = 0, to liczba nie jest pierwsza
   124                                  
   125 000000B7 43                          inc bx            ; Sprawdź kolejny dzielnik
   126 000000B8 EBEF                        jmp check_divisor
   127                                  
   128                                  prime_found:
   129 000000BA BB0100                      mov bx, 1         ; Liczba jest pierwsza
   130 000000BD C3                          ret
   131                                  
   132                                  not_a_prime:
   133 000000BE BB0000                      mov bx, 0         ; Liczba nie jest pierwsza
   134 000000C1 C3                          ret
   135                                  
   136                                  ;----------------------------------------------
   137                                  ; Procedura: get_number
   138                                  ; Pobiera liczbę od użytkownika
   139                                  ; Zwraca wynik w AX
   140                                  ;----------------------------------------------
   141                                  get_number:
   142 000000C2 31C0                        xor ax, ax         ; Wyzeruj AX, aby nie było śmieci
   143 000000C4 31DB                        xor bx, bx         ; Wyzeruj BX (będzie używany do przechowywania liczby)
   144                                  
   145                                  read_digit:
   146 000000C6 B401                        mov ah, 1          ; Funkcja DOS do odczytu znaku z klawiatury
   147 000000C8 CD21                        int 21h            ; Pobierz znak od użytkownika
   148                                  
   149                                      ; Debugowanie przy użyciu `print_string`
   150 000000CA BA[8600]                    mov dx, debug_char
   151 000000CD E81900                      call print_string
   152 000000D0 88C2                        mov dl, al
   153 000000D2 B402                        mov ah, 2
   154 000000D4 CD21                        int 21h
   155 000000D6 E83800                      call new_line
   156                                  
   157 000000D9 3C0D                        cmp al, 13         ; Sprawdź, czy Enter (kod ASCII 13)
   158 000000DB 7409                        je done_input      ; Jeśli Enter, zakończ wczytywanie
   159                                  
   160 000000DD 2C30                        sub al, '0'        ; Konwertuj znak ASCII na cyfrę
   161 000000DF 6BDB0A                      imul bx, 10        ; Przesuń poprzednie cyfry o jedno miejsce w lewo
   162 000000E2 01C3                        add bx, ax         ; Dodaj nową cyfrę do liczby
   163 000000E4 EBE0                        jmp read_digit     ; Kontynuuj wczytywanie kolejnych cyfr
   164                                  
   165                                  done_input:
   166 000000E6 89D8                        mov ax, bx         ; Przenieś wynik do AX
   167 000000E8 C3                          ret
   168                                  
   169                                  ;----------------------------------------------
   170                                  ; Procedura: print_string
   171                                  ; Wypisuje string zakończony znakiem $
   172                                  ;----------------------------------------------
   173                                  print_string:
   174 000000E9 50                          push ax
   175 000000EA 52                          push dx
   176 000000EB B409                        mov ah, 9
   177 000000ED CD21                        int 21h
   178 000000EF 5A                          pop dx
   179 000000F0 58                          pop ax
   180 000000F1 C3                          ret
   181                                  
   182                                  ;----------------------------------------------
   183                                  ; Procedura: print_number
   184                                  ; Wypisuje liczbę z AX
   185                                  ;----------------------------------------------
   186                                  print_number:
   187 000000F2 50                          push ax
   188 000000F3 31C9                        xor cx, cx
   189 000000F5 BB0A00                      mov bx, 10
   190                                      
   191                                  print_digit:
   192 000000F8 31D2                        xor dx, dx
   193 000000FA F7F3                        div bx
   194 000000FC 80C230                      add dl, '0'
   195 000000FF 52                          push dx
   196 00000100 41                          inc cx
   197 00000101 83F800                      cmp ax, 0
   198 00000104 75F2                        jne print_digit
   199                                  
   200                                  print_loop:
   201 00000106 5A                          pop dx
   202 00000107 B402                        mov ah, 2
   203 00000109 88C2                        mov dl, al
   204 0000010B CD21                        int 21h
   205 0000010D E2F7                        loop print_loop
   206 0000010F 58                          pop ax
   207 00000110 C3                          ret
   208                                  
   209                                  ;----------------------------------------------
   210                                  ; Procedura: new_line
   211                                  ; Wypisuje nową linię
   212                                  ;----------------------------------------------
   213                                  new_line:
   214 00000111 BA[0901]                    mov dx, newline
   215 00000114 E8D2FF                      call print_string
   216 00000117 C3                          ret
   217                                  
