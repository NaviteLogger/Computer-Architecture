    78 0000007C E87700                      call print_number
    79                                  
    80                                      ; Sprawdź, czy liczba jest pierwsza
    81 0000007F 50                          push ax          ; Zachowaj wartość na stosie
    82 00000080 E81C00                      call is_prime    ; Sprawdź, czy liczba jest pierwsza
    83 00000083 58                          pop ax           ; Przywróć wartość ze stosu
    84                                      
    85 00000084 83FB01                      cmp bx, 1        ; Jeśli BX = 1, to liczba jest pierwsza
    86 00000087 750C                        jne skip_number
    87                                  
    88                                      ; Wyświetl liczbę pierwszą
    89 00000089 BA[EC00]                    mov dx, prime_msg
    90 0000008C E85D00                      call print_string
    91 0000008F E86400                      call print_number
    92 00000092 E88000                      call new_line
    93                                  
    94                                  skip_number:
