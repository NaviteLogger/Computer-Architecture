     1                                  section .text
     2                                      org 100h
     3                                  
     4                                  start:
     5 00000000 E80B00                      call get_input       ; Pobierz zakres od użytkownika
     6 00000003 BA[3100]                    mov dx, after_input
     7 00000006 E8CD00                      call print_string
     8 00000009 E84F00                      call find_primes     ; Znajdź liczby pierwsze
     9 0000000C EBF2                        jmp start            ; Powtarzaj operację dla nowych zakresów
    10                                  
    11                                  ;----------------------------------------------
    12                                  ; Procedura: get_input
    13                                  ; Pobiera zakres od użytkownika
    14                                  ;----------------------------------------------
    15                                  get_input:
    16                                      ; Pobierz minimalną wartość
    17 0000000E BA[0000]                    mov dx, prompt1        ; 1. Załaduj adres `prompt1` do rejestru DX
    18 00000011 E8C200                      call print_string      ; 2. Wywołaj procedurę `print_string` (wypisuje "Enter min value:")
    19 00000014 E8A300                      call get_number        ; 3. Wywołaj procedurę `get_number`, aby pobrać liczbę od użytkownika
    20 00000017 A3[0000]                    mov [min], ax          ; 4. Zapisz wartość z rejestru AX do zmiennej `min`
    21                                  
    22                                      ; Debug: Sprawdź, co zapisano w `min`
    23 0000001A A1[0000]                    mov ax, [min]          ; 5. Załaduj wartość `min` z pamięci do rejestru AX
    24 0000001D BA[9000]                    mov dx, debug_min_set  ; 6. Załaduj adres komunikatu debugowego do rejestru DX
    25 00000020 E8B300                      call print_string      ; 7. Wypisz komunikat "Value set for min:"
    26 00000023 E8B500                      call print_number      ; 8. Wypisz wartość z rejestru AX
    27 00000026 E8D100                      call new_line          ; 9. Przejdź do nowej linii
    28                                  
    29                                      
    30                                      ; Pobierz maksymalną wartość
    31 00000029 BA[1200]                    mov dx, prompt2
    32 0000002C E8A700                      call print_string
    33 0000002F E88800                      call get_number
    34 00000032 A3[0200]                    mov [max], ax    ; Zapisz wartość w `max`
    35                                  
    36                                      ; Debug: Sprawdź, co zapisano w `max`
    37 00000035 A1[0200]                    mov ax, [max]
    38 00000038 BA[A400]                    mov dx, debug_max_set
    39 0000003B E89800                      call print_string
    40 0000003E E89A00                      call print_number
    41 00000041 E8B600                      call new_line
    42                                  
    43                                      ; Sprawdź, czy min < max
    44 00000044 A1[0000]                    mov ax, [min]
    45 00000047 3B06[0200]                  cmp ax, [max]
    46 0000004B 7D07                        jge invalid_range
    47                                  
    48                                      ; Debugowanie to moja pasja
    49 0000004D BA[2400]                    mov dx, valid_range
    50 00000050 E88300                      call print_string
    51                                  
    52 00000053 C3                          ret
    53                                  
    54                                  invalid_range:
    55 00000054 BA[4E00]                    mov dx, invalid_input
    56 00000057 E87C00                      call print_string
    57 0000005A C3                          ret
    58                                  
    59                                  ;----------------------------------------------
    60                                  ; Procedura: find_primes
    61                                  ; Znajduje liczby pierwsze w zadanym przedziale
    62                                  ;----------------------------------------------
    63                                  find_primes:
    64 0000005B A1[0000]                    mov ax, [min]
    65 0000005E BA[7800]                    mov dx, debug_min
    66 00000061 E87200                      call print_string
    67 00000064 E87400                      call print_number
    68 00000067 E89000                      call new_line
    69                                  
    70 0000006A A1[0200]                    mov ax, [max]
    71 0000006D BA[8400]                    mov dx, debug_max
    72 00000070 E86300                      call print_string
    73 00000073 E86500                      call print_number
    74 00000076 E88100                      call new_line
    75                                  
    76 00000079 A1[0000]                    mov ax, [min]
    77                                      
    78                                  next_number:
    79 0000007C 3B06[0200]                  cmp ax, [max]    ; Czy osiągnęliśmy max?
    80 00000080 7F19                        jg done          ; Jeśli tak, zakończ
    81                                      
    82 00000082 50                          push ax          ; Zachowaj wartość na stosie
    83 00000083 E81600                      call is_prime    ; Sprawdź, czy liczba jest pierwsza
    84 00000086 58                          pop ax           ; Przywróć wartość ze stosu
    85                                      
    86 00000087 83FB01                      cmp bx, 1        ; Jeśli BX = 1, to liczba jest pierwsza
    87 0000008A 750C                        jne skip_number
    88                                  
    89                                      ; Wyświetl liczbę pierwszą
    90 0000008C BA[CD00]                    mov dx, prime_msg
    91 0000008F E84400                      call print_string
    92 00000092 E84600                      call print_number
    93 00000095 E86200                      call new_line
    94                                  
    95                                  skip_number:
    96 00000098 40                          inc ax           ; Przejdź do następnej liczby
    97 00000099 EBE1                        jmp next_number
    98                                  
    99                                  done:
   100 0000009B C3                          ret
   101                                  
   102                                  ;----------------------------------------------
   103                                  ; Procedura: is_prime
   104                                  ; Sprawdza, czy liczba w AX jest pierwsza
   105                                  ; Zwraca wynik w BX (1 = pierwsza, 0 = niepierwsza)
   106                                  ;----------------------------------------------
   107                                  is_prime:
   108 0000009C BB0200                      mov bx, 2
   109 0000009F 89C1                        mov cx, ax
   110                                      
   111                                  check_divisor:
   112 000000A1 39CB                        cmp bx, cx
   113 000000A3 7D0D                        jge prime_found   ; Jeśli bx >= cx, liczba jest pierwsza
   114                                  
   115                                      ; Sprawdź, czy ax jest podzielne przez bx
   116 000000A5 BA0000                      mov dx, 0
   117 000000A8 F7F3                        div bx
   118 000000AA 83FA00                      cmp dx, 0
   119 000000AD 7407                        je not_a_prime    ; Jeśli reszta = 0, to liczba nie jest pierwsza
   120                                  
   121 000000AF 43                          inc bx            ; Sprawdź kolejny dzielnik
   122 000000B0 EBEF                        jmp check_divisor
   123                                  
   124                                  prime_found:
   125 000000B2 BB0100                      mov bx, 1         ; Liczba jest pierwsza
   126 000000B5 C3                          ret
   127                                  
   128                                  not_a_prime:
   129 000000B6 BB0000                      mov bx, 0         ; Liczba nie jest pierwsza
   130 000000B9 C3                          ret
   131                                  
   132                                  ;----------------------------------------------
   133                                  ; Procedura: get_number
   134                                  ; Pobiera liczbę od użytkownika
   135                                  ; Zwraca wynik w AX
   136                                  ;----------------------------------------------
   137                                  get_number:
   138 000000BA 31C0                        xor ax, ax         ; Wyzeruj AX, aby nie było śmieci
   139 000000BC 31DB                        xor bx, bx         ; Wyzeruj BX (będzie używany do przechowywania liczby)
   140                                  
   141                                  read_digit:
   142 000000BE B401                        mov ah, 1        ; Funkcja DOS do odczytu znaku z klawiatury
   143                                  
   144                                      ; Sprawdzenie co zostało wpisane
   145 000000C0 B402                        mov ah, 2
   146                                      mov dx, al
   146          ******************       error: invalid combination of opcode and operands
   147 000000C2 CD21                        int 21h
   148                                      
   149 000000C4 CD21                        int 21h            ; Pobierz znak od użytkownika
   150 000000C6 3C0D                        cmp al, 13         ; Sprawdź, czy Enter (kod ASCII 13)
   151 000000C8 7409                        je done_input      ; Jeśli Enter, zakończ wczytywanie
   152                                  
   153 000000CA 2C30                        sub al, '0'        ; Konwertuj znak ASCII na cyfrę
   154 000000CC 6BDB0A                      imul bx, 10        ; Przesuń poprzednie cyfry o jedno miejsce w lewo
   155 000000CF 01C3                        add bx, ax         ; Dodaj nową cyfrę do liczby
   156 000000D1 EBEB                        jmp read_digit     ; Kontynuuj wczytywanie kolejnych cyfr
   157                                  
   158                                  done_input:
   159 000000D3 89D8                        mov ax, bx         ; Przenieś wynik do AX
   160 000000D5 C3                          ret
   161                                  
   162                                  ;----------------------------------------------
   163                                  ; Procedura: print_string
   164                                  ; Wypisuje string zakończony znakiem $
   165                                  ;----------------------------------------------
   166                                  print_string:
   167 000000D6 B409                        mov ah, 9
   168 000000D8 CD21                        int 21h
   169 000000DA C3                          ret
   170                                  
   171                                  ;----------------------------------------------
   172                                  ; Procedura: print_number
   173                                  ; Wypisuje liczbę z AX
   174                                  ;----------------------------------------------
   175                                  print_number:
   176 000000DB 50                          push ax
   177 000000DC 31C9                        xor cx, cx
   178 000000DE BB0A00                      mov bx, 10
   179                                      
   180                                  print_digit:
   181 000000E1 31D2                        xor dx, dx
   182 000000E3 F7F3                        div bx
   183 000000E5 80C230                      add dl, '0'
   184 000000E8 52                          push dx
   185 000000E9 41                          inc cx
   186 000000EA 83F800                      cmp ax, 0
   187 000000ED 75F2                        jne print_digit
   188                                  
   189                                  print_loop:
   190 000000EF 5A                          pop dx
   191 000000F0 B402                        mov ah, 2
   192 000000F2 88C2                        mov dl, al
   193 000000F4 CD21                        int 21h
   194 000000F6 E2F7                        loop print_loop
   195 000000F8 58                          pop ax
   196 000000F9 C3                          ret
   197                                  
   198                                  ;----------------------------------------------
   199                                  ; Procedura: new_line
   200                                  ; Wypisuje nową linię
   201                                  ;----------------------------------------------
   202                                  new_line:
   203 000000FA BA[D500]                    mov dx, newline
   204 000000FD E8D6FF                      call print_string
   205 00000100 C3                          ret
   206                                  
