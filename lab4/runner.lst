     1                                  section .bss
     2 00000000 ??                          digit1 resb 1
     3 00000001 ??                          digit2 resb 1
     4 00000002 ??                          digit3 resb 1
     5                                  
     6                                  section .text
     7                                      global _start
     8                                  
     9                                  _start:
    10                                      ; Clear screen by resetting display mode
    11 00000000 B400                        mov ah, 0            ; BIOS function to set video mode
    12 00000002 B003                        mov al, 3            ; Mode 3 (standard 80x25 text mode)
    13 00000004 CD10                        int 10h              ; Clears the screen and resets the cursor
    14                                  
    15                                      ; Initialize digits to 0 to avoid reading any residual memory data
    16 00000006 C606[0000]00                mov byte [digit1], 0
    17 0000000B C606[0100]00                mov byte [digit2], 0
    18 00000010 C606[0200]00                mov byte [digit3], 0
    19                                  
    20                                      ; Read first digit
    21 00000015 B401                        mov ah, 01h          ; Single character input function
    22 00000017 CD21                        int 21h
    23 00000019 A2[0000]                    mov [digit1], al     ; Store first digit in digit1
    24                                      
    25                                      ; Read second digit
    26 0000001C B401                        mov ah, 01h
    27 0000001E CD21                        int 21h
    28 00000020 A2[0100]                    mov [digit2], al     ; Store second digit in digit2
    29                                  
    30                                      ; Read third digit
    31 00000023 B401                        mov ah, 01h
    32 00000025 CD21                        int 21h
    33 00000027 A2[0200]                    mov [digit3], al     ; Store third digit in digit3
    34                                      
    35                                      ; Display the first digit
    36 0000002A B402                        mov ah, 02h          ; Single character output function
    37 0000002C 8A16[0000]                  mov dl, [digit1]
    38 00000030 CD21                        int 21h
    39                                  
    40                                      ; Display the second digit
    41 00000032 B402                        mov ah, 02h
    42 00000034 8A16[0100]                  mov dl, [digit2]
    43 00000038 CD21                        int 21h
    44                                  
    45                                      ; Display the third digit
    46 0000003A B402                        mov ah, 02h
    47 0000003C 8A16[0200]                  mov dl, [digit3]
    48 00000040 CD21                        int 21h
    49                                      
    50                                      ; Exit program
    51 00000042 B44C                        mov ah, 4Ch          ; DOS interrupt for program termination
    52 00000044 CD21                        int 21h
