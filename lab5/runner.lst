     1                                  section .text
     2                                      org 100h
     3                                  global _start
     4                                  
     5                                  _start:
     6                                  input_loop:
     7                                      ; Display prompt message
     8 00000000 B409                        mov ah, 9                ; DOS function to display a string
     9 00000002 BA[0000]                    mov dx, prompt           ; Load the address of the prompt message
    10 00000005 CD21                        int 21h                ; Call DOS interrupt to display the prompt
    11                                  
    12                                      ; Read a character from input
    13 00000007 B401                        mov ah, 1                ; DOS function to read a character from input
    14 00000009 CD21                        int 21h                 ; Call DOS interrupt to read the character
    15 0000000B 3C24                        cmp al, 36              ; Check if the character is '$'
    16 0000000D 7408                        je end_loop              ; If it is, jump to end the loop
    17                                  
    18                                      ; Display the character entered
    19 0000000F 88C2                        mov dl, al               ; Move the character to DL for printing
    20 00000011 B402                        mov ah, 2                ; DOS function to print a character
    21 00000013 CD21                        int 21h                ; Call DOS interrupt to print the character
    22                                  
    23 00000015 EBE9                        jmp input_loop           ; Loop back to prompt for the next character
    24                                  
    25                                  end_loop:
    26 00000017 B8004C                      mov ax, 0x4C00           ; DOS function to terminate the program
    27 0000001A CD21                        int 21h                 ; Call DOS interrupt to end the program
    28                                  
    29                                  section .data
    30 00000000 456E74657220612063-         prompt db "Enter a character: $"  ; Prompt message to display
    30 00000009 68617261637465723A-
    30 00000012 2024               
